# URL del motor editorial remoto en Dokploy
NUXT_PUBLIC_NEWS_API_URL=https://cms-etv.webia.studio

# Clave de API de Contenido Editorial (Pública / Solo Lectura)
NUXT_PUBLIC_NEWS_API_KEY=

# Clave de API de Administración de Ghost (Privada / Servidor - Para creación de artículos)
NEWS_ADMIN_API_KEY=

# Conexión PostgreSQL compartida para usuarios finales del portal
DATABASE_URL=postgresql://usuario:password@host:5433/panel_evoluciontv

# Secreto para firmar cookies de sesión HttpOnly (mínimo 32 caracteres)
NUXT_SESSION_SECRET=reemplazar-por-clave-secreta-minimo-32-caracteres

# Google OAuth 2.0 (Portal de usuarios finales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
